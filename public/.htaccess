# ================================================================
# Byron Portfolio — Server Configuration (.htaccess)
# ================================================================

# 1. Disable directory browsing for security
Options -Indexes

# 2. Block access to hidden files and sensitive extensions (log, sql, ini, env, txt, conf, bak)
<FilesMatch "(^\.|\.(bak|conf|dist|fla|in[ci]|log|psd|sh|sql|sw[op]|txt|env|md)$)">
    Order allow,deny
    Deny from all
</FilesMatch>

# Explicitly allow safe public files
<FilesMatch "^(robots\.txt|sitemap\.xml)$">
    Order allow,deny
    Allow from all
</FilesMatch>

# Allow content.json
<Files "content.json">
    Order allow,deny
    Allow from all
</Files>

# 3. Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 4. Gzip Compression for maximum loading speed
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE text/javascript application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/xml
    AddOutputFilterByType DEFLATE image/svg+xml font/woff font/woff2
</IfModule>

# 5. Browser Caching (Expires Headers)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # HTML files — no cache to ensure instant updates
    ExpiresByType text/html "access plus 0 seconds"

    # JSON files — no cache for instant CMS updates
    ExpiresByType application/json "access plus 0 seconds"

    # CSS and JavaScript (Vite fingerprinted files)
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"

    # Images and Fonts
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
</IfModule>

# 6. Ensure correct UTF-8 charset
AddDefaultCharset UTF-8
